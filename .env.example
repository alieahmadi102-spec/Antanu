# =====================================================
#  تنظیمات آنتانو — قسمت وارد کردن API ها
#
#  طرز استفاده:
#  ۱) یک کپی از این فایل بسازید و نامش را دقیقاً  .env  بگذارید
#  ۲) کلیدهای خود را جای ... بگذارید
#  ۳) خط‌هایی که لازم ندارید را با # غیرفعال کنید
#  ⛔ فایل .env هرگز روی گیت‌هاب آپلود نمی‌شود
# =====================================================

# ---------- هوش مصنوعی اصلی: «آنتانو (خودکار)» ----------
# با کلید گراک شما کار می‌کند
ANTANU_PROVIDER=groq
ANTANU_API_KEY=gsk_...

# ---------- بقیه هوش مصنوعی‌ها (هر خط = یک گزینه در منوی کاربر) ----------
# قالب:  نام نمایشی | سرویس | نام مدل | کلید
# سرویس: groq / gemini / github / openrouter / یا آدرس کامل API

# جمنای گوگل — کلید رایگان از aistudio.google.com/apikey
ANTANU_AI_1=جمنای گوگل | gemini | gemini-2.0-flash | AIza...

# چت جی‌پی‌تی — انتخاب یکی از سه حالت زیر:

# حالت الف) کلید پولی OpenAI دارید (با sk- شروع می‌شود):
# ANTANU_AI_2=چت جی‌پی‌تی | https://api.openai.com/v1 | gpt-4o-mini | sk-...

# حالت ب) رایگان — مدل متن‌باز OpenAI با کلید OpenRouter:
# ANTANU_AI_2=جی‌پی‌تی (OpenAI) | openrouter | openai/gpt-oss-120b:free | sk-or-v1-...

# حالت ج) رایگان — GPT-4o-mini واقعی با توکن گیت‌هاب (حدود ۵۰ پیام در روز):
# ANTANU_AI_2=جی‌پی‌تی ۴ | github | openai/gpt-4o-mini | github_pat_...

# انویدیا — کلید رایگان از build.nvidia.com (با ثبت‌نام):
# ANTANU_AI_3=انویدیا | nvidia | meta/llama-3.3-70b-instruct | nvapi-...

# سربراس — کلید رایگان از cloud.cerebras.ai:
# ANTANU_AI_4=سربراس | cerebras | llama-3.3-70b | csk-...

# می‌توانید تا ۱۰ هوش مصنوعی اضافه کنید: ANTANU_AI_5 ، ANTANU_AI_6 ، ...
# ANTANU_AI_3=دیپ‌سیک | openrouter | deepseek/deepseek-r1-distill:free | sk-or-v1-...

# ---------- اختیاری ----------
# ANTANU_ADMIN_USER=admin
# ANTANU_ADMIN_PASS=Antanu@1234
# ANTANU_ADMIN_CONTACT=آیدی تلگرام: @my_id
